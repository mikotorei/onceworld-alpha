8px;" hidden&gt;&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div class="effectbox"&gt;&lt;div class="acc-effect-preview" id="effect_accessory4"&gt;-&lt;/div&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/details&gt;&#10;&lt;details class="fold" id="foldPet" open&gt;&#10; &lt;summary&gt;ペットスキル&lt;/summary&gt;&#10; &lt;div class="stat-filter-row"&gt;&#10; &lt;span class="stat-filter-label"&gt;ステ絞り込み&lt;/span&gt;&#10; &lt;div class="chip-group"&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="all" aria-pressed="true"&gt;クリア&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="vit" aria-pressed="false"&gt;VIT&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="spd" aria-pressed="false"&gt;SPD&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="atk" aria-pressed="false"&gt;ATK&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="int" aria-pressed="false"&gt;INT&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="def" aria-pressed="false"&gt;DEF&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="mdef" aria-pressed="false"&gt;MDEF&lt;/button&gt;&#10; &lt;button type="button" class="chip-btn stat-filter-btn" data-stat="luk" aria-pressed="false"&gt;LUK&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="equip-grid"&gt;&#10; &lt;div class="equip-row pet-row"&gt;&#10; &lt;div class="slot"&gt;ペット1&lt;/div&gt;&#10; &lt;div class="main"&gt;&#10; &lt;div class="pet-search-wrap"&gt;&#10; &lt;input id="pet_search_pet1" type="search" placeholder="名前で検索して選択" autocomplete="off"&gt;&#10; &lt;div id="pet_suggest_pet1" class="pet-suggest" hidden&gt;&lt;/div&gt;&#10; &lt;select id="select_pet1" hidden&gt;&lt;/select&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="lv-row"&gt;&#10; &lt;span class="lvtag"&gt;段階&lt;/span&gt;&#10; &lt;div class="lvbox"&gt;&#10; &lt;select id="stage_pet1"&gt;&#10; &lt;option value="0"&gt;なし&lt;/option&gt;&#10; &lt;option value="1"&gt;一段階&lt;/option&gt;&#10; &lt;option value="2"&gt;二段階&lt;/option&gt;&#10; &lt;option value="3"&gt;三段階&lt;/option&gt;&#10; &lt;option value="4"&gt;四段階&lt;/option&gt;&#10; &lt;option value="5"&gt;五段階&lt;/option&gt;&#10; &lt;/select&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="equip-row pet-row"&gt;&#10; &lt;div class="slot"&gt;ペット2&lt;/div&gt;&#10; &lt;div class="main"&gt;&#10; &lt;div class="pet-search-wrap"&gt;&#10; &lt;input id="pet_search_pet2" type="search" placeholder="名前で検索して選択" autocomplete="off"&gt;&#10; &lt;div id="pet_suggest_pet2" class="pet-suggest" hidden&gt;&lt;/div&gt;&#10; &lt;select id="select_pet2" hidden&gt;&lt;/select&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="lv-row"&gt;&#10; &lt;span class="lvtag"&gt;段階&lt;/span&gt;&#10; &lt;div class="lvbox"&gt;&#10; &lt;select id="stage_pet2"&gt;&#10; &lt;option value="0"&gt;なし&lt;/option&gt;&#10; &lt;option value="1"&gt;一段階&lt;/option&gt;&#10; &lt;option value="2"&gt;二段階&lt;/option&gt;&#10; &lt;option value="3"&gt;三段階&lt;/option&gt;&#10; &lt;option value="4"&gt;四段階&lt;/option&gt;&#10; &lt;option value="5"&gt;五段階&lt;/option&gt;&#10; &lt;/select&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="equip-row pet-row"&gt;&#10; &lt;div class="slot"&gt;ペット3&lt;/div&gt;&#10; &lt;div class="main"&gt;&#10; &lt;div class="pet-search-wrap"&gt;&#10; &lt;input id="pet_search_pet3" type="search" placeholder="名前で検索して選択" autocomplete="off"&gt;&#10; &lt;div id="pet_suggest_pet3" class="pet-suggest" hidden&gt;&lt;/div&gt;&#10; &lt;select id="select_pet3" hidden&gt;&lt;/select&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="lv-row"&gt;&#10; &lt;span class="lvtag"&gt;段階&lt;/span&gt;&#10; &lt;div class="lvbox"&gt;&#10; &lt;select id="stage_pet3"&gt;&#10; &lt;option value="0"&gt;なし&lt;/option&gt;&#10; &lt;option value="1"&gt;一段階&lt;/option&gt;&#10; &lt;option value="2"&gt;二段階&lt;/option&gt;&#10; &lt;option value="3"&gt;三段階&lt;/option&gt;&#10; &lt;option value="4"&gt;四段階&lt;/option&gt;&#10; &lt;option value="5"&gt;五段階&lt;/option&gt;&#10; &lt;/select&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/details&gt;&#10;&lt;/div&gt;&#10;&lt;p&gt;&lt;button id="bcOpenBtn" type="button" class="bc-open-btn"&gt;📷 画像を生成&lt;/button&gt;&lt;/p&gt;</description></item><item><title>ビルドシミュレーター</title><link>https://mikotorei.github.io/onceworld-alpha/tools/build-sim/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://mikotorei.github.io/onceworld-alpha/tools/build-sim/</guid><description/></item><item><title>ペットステータスシミュレーター</title><link>https://mikotorei.github.io/onceworld-alpha/tools/pet-sim/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://mikotorei.github.io/onceworld-alpha/tools/pet-sim/</guid><description/></item><item><title>統合計算機</title><link>https://mikotorei.github.io/onceworld-alpha/tools/calc/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://mikotorei.github.io/onceworld-alpha/tools/calc/</guid><description/></item><item><title>天空回廊計算表</title><link>https://mikotorei.github.io/onceworld-alpha/tools/tenku/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://mikotorei.github.io/onceworld-alpha/tools/tenku/</guid><description/></item><item><title>必要経験値計算機</title><link>https://mikotorei.github.io/onceworld-alpha/tools/exp-calc/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://mikotorei.github.io/onceworld-alpha/tools/exp-calc/</guid><description/></item><item><title>天空回廊のノウハウ</title><link>https://mikotorei.github.io/onceworld-alpha/tools/guide/tenku-corridor/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://mikotorei.github.io/onceworld-alpha/tools/guide/tenku-corridor/</guid><description>&lt;h2 id="概要"&gt;概要&lt;/h2&gt;&#10;&lt;p&gt;天空回廊は&lt;strong&gt;無限崖&lt;/strong&gt;から&lt;strong&gt;天空エントランス&lt;/strong&gt;に入場することで挑戦できます。入場には&lt;strong&gt;オリハルコン級&lt;/strong&gt;であることが必要です。&lt;/p&gt;&#10;&lt;p&gt;天空エントランスから&lt;a href="https://mikotorei.github.io/onceworld-alpha/item/%E8%99%B9%E3%81%AE%E3%82%A8%E3%83%AB%E3%83%89%E3%82%B7%E3%83%BC%E3%83%89/"&gt;虹のエルドシード&lt;/a&gt;を1個消費することで「天空回廊」に入場できます。前々作「Re:END」に登場した「END」と似た仕様です。&lt;/p&gt;&#10;&lt;h3 id="基本ルール"&gt;基本ルール&lt;/h3&gt;&#10;&lt;p&gt;不死鳥のエキスやクリスタルによる復活は不可で、死亡すると強制的にデスペナルティを受けます。交換・深淵回廊を除く全モンスターと数種の新モンスターがランダムで出現し、敵のレベルは &lt;strong&gt;10000 + 現在の階層 × 100&lt;/strong&gt; です。&lt;/p&gt;&#10;&lt;h3 id="階層の進み方"&gt;階層の進み方&lt;/h3&gt;&#10;&lt;p&gt;片側の敵を全滅すると次の階層へ進めます（+1F）。もう片側も全滅させると一度に &lt;strong&gt;+2F&lt;/strong&gt; 進みます。&lt;strong&gt;天空像～冒険者～&lt;/strong&gt;を所持していると、所持数分さらに追加で進みます。&lt;/p&gt;&#10;&lt;h3 id="スカイガーディアン"&gt;スカイガーディアン&lt;/h3&gt;&#10;&lt;p&gt;100層ごとに次への階段前にスカイガーディアンが出現します。撃破すると &lt;strong&gt;+99F&lt;/strong&gt; 進みます。&lt;strong&gt;天空像～悪魔～&lt;/strong&gt;を所持していると、所持数 × 100F 追加で進みます。&lt;/p&gt;&#10;&lt;h3 id="天空宝物庫"&gt;天空宝物庫&lt;/h3&gt;&#10;&lt;p&gt;稀に「天空宝物庫」へ移動することがあります。全ての通常素材からランダムで &lt;strong&gt;100 + 現在の階層 ÷ 100（小数点以下切り捨て）個&lt;/strong&gt; 入手できます。&lt;/p&gt;&#10;&lt;h3 id="天空大航海"&gt;天空大航海&lt;/h3&gt;&#10;&lt;p&gt;10000Fに入場すると「天空大航海」へ移動します。&lt;/p&gt;&#10;&lt;hr&gt;&#10;&lt;h2 id="攻略のコツ"&gt;攻略のコツ&lt;/h2&gt;&#10;&lt;h3 id="はじめに"&gt;はじめに&lt;/h3&gt;&#10;&lt;p&gt;まず&lt;a href="https://mikotorei.github.io/onceworld-alpha/item/%E5%A4%A9%E7%A9%BA%E5%83%8F~%E5%86%92%E9%99%BA%E8%80%85~/"&gt;天空像～冒険者～&lt;/a&gt;を集めるために100Fを目指そう！&lt;/p&gt;&#10;&lt;p&gt;10000Fの「天空大航海」にたどり着いて隠し通路にある[身代わりの御霊]を回収、「海賊船長ボンゴレ」の討伐とドロップ品集めが目標。&lt;/p&gt;&#10;&lt;h3 id="見つけたらうれしいモンスター"&gt;見つけたらうれしいモンスター&lt;/h3&gt;&#10;&lt;p&gt;BIG BOX、SBB、RAINBOW BOX、オコォーン&lt;/p&gt;&#10;&lt;p&gt;効果素材が集まっていないモンスター&lt;/p&gt;&#10;&lt;p&gt;捕獲が進んでいないレア敵・強敵&lt;/p&gt;&#10;&lt;h3 id="要注意モンスター"&gt;要注意モンスター&lt;/h3&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&lt;strong&gt;オコォーン&lt;/strong&gt;（オーディンの攻撃範囲外から索敵してくる）&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;オメガ・リガミア・パルテノン・ダークフェニックス・トリカゴドリ&lt;/strong&gt;（速かったりデカかったりで処理が間に合わないことがある）&lt;/li&gt;&#10;&lt;li&gt;&lt;strong&gt;黙示木・オコスター・零・巨木&lt;/strong&gt;（Mdef盛っていないと気付いた頃にはやられている）&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;h3 id="歩き方"&gt;歩き方&lt;/h3&gt;&#10;&lt;p&gt;ページ下部にあるツールを用いて自分の行きたい階層に行くために必要な天空像を揃えて歩こう。&lt;/p&gt;&#10;&lt;p&gt;エリア移動して左右を見て、倒したい方もしくは避けたいモンスターのいない方を選びながら歩こう。&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://mikotorei.github.io/onceworld-alpha/tools/tenku/"&gt;天空回廊計算表&lt;/a&gt;を参考に必要なステータスを調べて自分に合ったビルドや再現をしていこう！&lt;/p&gt;&#10;&lt;h3 id="ボスフロアを踏んだときは"&gt;ボスフロアを踏んだときは&lt;/h3&gt;&#10;&lt;p&gt;ページ下部のツールが出す組み合わせには、&lt;strong&gt;ボスフロア&lt;/strong&gt;（1万・10万・100万・1000万F）を通過するものが含まれます。ボスフロアに着いたら、次の手順でSG（スカイガーディアン）のループに戻れます。&lt;/p&gt;&#10;&lt;ol&gt;&#10;&lt;li&gt;ボスを討伐して先に進む&lt;/li&gt;&#10;&lt;li&gt;&lt;a href="https://mikotorei.github.io/onceworld-alpha/item/%E5%A4%A9%E7%A9%BA%E5%83%8F~%E5%86%92%E9%99%BA%E8%80%85~/"&gt;天空像～冒険者～&lt;/a&gt;を2個外して片側を殲滅する&lt;/li&gt;&#10;&lt;li&gt;外した2個を回収して先に進む&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;p&gt;これで100の倍数のフロアに戻り、SGが出現するようになります。&lt;/p&gt;&#10;&lt;h3 id="その他のコツ"&gt;その他のコツ&lt;/h3&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;眠いときは事故率が上がるので寝よう&lt;/li&gt;&#10;&lt;li&gt;主人公を強化する要素（魔晶や魔晶や魔晶）は暇を見つけて集めよう&lt;/li&gt;&#10;&lt;li&gt;集まるまでやれば集まる。サクサクなときはサクサク。悩む暇があったら手を動かそう。&lt;/li&gt;&#10;&lt;li&gt;困ったらコミュニティやSNSで調べたり相談したりしよう！&lt;/li&gt;&#10;&lt;/ul&gt;</description></item></channel></rss>